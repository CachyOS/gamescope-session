#!/bin/bash
set -e

DISPLAY_MANAGER="$(systemctl show -p Id --value display-manager)"
# Restrict the privileged helper to the two supported sessions.
SESSION="${1:-gamescope-session.desktop}"
case "$SESSION" in
    gamescope-session.desktop|plasma.desktop) ;;
    *) echo "Unsupported session: $SESSION" >&2; exit 1;;
esac

case "${DISPLAY_MANAGER%.service}" in
    plasmalogin)
        # Plasma Login Manager enumerates drop-ins only once at startup. A new
        # drop-in created on the first switch is therefore ignored until restart.
        # Its main config path is always loaded, including when initially absent.
        kwriteconfig6 --file /etc/plasmalogin.conf --group Autologin --key Session "$SESSION"
        exit 0;;
    sddm) CONF_FILE="/etc/sddm.conf.d/zz-steamos-autologin.conf";;
esac

# Don't do anything if system is using unsupported display manager
[[ -z "$CONF_FILE" ]] && exit 0

if [[ ! -d "$(dirname "$CONF_FILE")" ]]; then
    mkdir -p "$(dirname "$CONF_FILE")"
fi

cat <<EOF > "$CONF_FILE"
[Autologin]
Session=$SESSION
EOF
